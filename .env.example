# Optional. Without a key SuiteSpot runs in demo mode (keyless, deterministic).
ANTHROPIC_API_KEY=
# Optional. Mozaik Cloud tracing; alternatively run `npx @mozaik-ai/cloud-sdk pair` once.
MOZAIK_API_KEY=
# Server port (Railway sets PORT automatically).
PORT=3000
# Optional. demo (default, keyless) or live (needs ANTHROPIC_API_KEY).
SUITESPOT_MODE=demo
# Optional. Access code for live mode: when set, live runs need it (users enter it under Settings). Empty: live mode is open.
SUITESPOT_ACCESS_CODE=
