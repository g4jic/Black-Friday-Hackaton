# Optional. With a key the agents use the real model (claude-haiku-4-5, your own cost). Without it SuiteSpot runs the
# keyless demo: scripted answers on the synthetic demo listings, clearly labelled on every result screen.
ANTHROPIC_API_KEY=
# Optional. Mozaik Cloud tracing; alternatively run `npx @mozaik-ai/cloud-sdk pair` once.
MOZAIK_API_KEY=
# Server port (Railway sets PORT automatically).
PORT=3000

# Accounts, listings and deals (Supabase). Leave empty for local accounts and a local store on this machine.
# The anon key is public (the browser gets it from /api/auth-config). The service role key is for the seed script
# and the server only: never in the frontend, never in git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rent payments. Leave both empty for the simulated checkout ("Simulated payment, no real money"): the full flow
# works without any key. With both Stripe TEST keys (sk_test_..., pk_test_...) the same button opens Stripe Checkout
# in test mode (fake money, test card 4242 4242 4242 4242). Live keys are refused.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
