# Optional. With a key the agents use the real model (claude-haiku-4-5, your own cost). Without it the three example
# businesses replay recorded real runs and every other run uses scripted agents (see the README).
ANTHROPIC_API_KEY=
# Optional. Mozaik Cloud tracing; alternatively run `npx @mozaik-ai/cloud-sdk pair` once.
MOZAIK_API_KEY=
# Server port (Railway sets PORT automatically).
PORT=3000

# Accounts, listings and deals (Supabase). Leave empty for local accounts and a local store on this machine.
# The anon key is public (the browser gets it from /api/auth-config). The service role key is for the seed script
# and the server only: never in the frontend, never in git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rent payments. Leave both empty for the simulated checkout (no card, no money): the full flow
# works without any key. With both Stripe TEST keys (secret sk_test_, rk_test_ or rkcs_test_, and pk_test_) the same
# button opens Stripe Checkout in test mode (fake money, test card 4242 4242 4242 4242). Live keys are refused.
# No Stripe account? `stripe sandbox create --email <you>` (Stripe CLI) makes an anonymous sandbox with test keys
# that works for 7 days, also from countries Stripe does not support (tested from Serbia, 27 Nov 2026).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
