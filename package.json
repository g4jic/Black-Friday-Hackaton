{
  "name": "suitespot",
  "version": "0.1.0",
  "private": true,
  "description": "SuiteSpot: Mozaik agents evaluate commercial leases for small businesses, in parallel, with every number sourced.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/adapters/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/adapters/server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "check:anthropic": "tsx scripts/check-anthropic-tools.ts",
    "check:listings": "tsx scripts/check-listing-fetch.ts",
    "demo:scout": "tsx scripts/demo-scout.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.74.0",
    "@fastify/static": "8.3.0",
    "@mozaik-ai/core": "6.0.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.8",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.7",
    "@types/react": "18.3.32",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
